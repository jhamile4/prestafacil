# Copie este archivo como .env (no se sube a GitHub) y complete los valores.

# Contraseña del usuario sa de SQL Server: mínimo 8 caracteres con mayúsculas,
# minúsculas, números y símbolos (requisito de SQL Server)
MSSQL_SA_PASSWORD=

# Clave para firmar los tokens JWT: mínimo 32 caracteres aleatorios
JWT_KEY=

# Contraseña que tendrán los usuarios de prueba (admin, asesor1, asesor2, cajero1)
DEMO_PASSWORD=
